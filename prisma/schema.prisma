// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH
// ============================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // ADMIN | PASTOR | LIDER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model StoredFile {
  id          String   @id @default(cuid())
  key         String   @unique
  contentType String
  data        Bytes
  size        Int
  createdAt   DateTime @default(now())

  @@map("stored_files")
}

// ============================================
// IEAB GESTAO - Data Models
// ============================================

model Person {
  id            String    @id @default(cuid())
  fullName      String
  cpf           String?   @unique
  email         String?
  phone         String?
  birthDate     DateTime?
  maritalStatus String? // SOLTEIRO | CASADO | DIVORCIADO | VIUVO
  weddingDate   DateTime?
  profession    String?
  personType    String    @default("VISITANTE") // MEMBRO | VISITANTE | CONGREGADO
  memberStatus  String    @default("ATIVO") // ATIVO | INATIVO | TRANSFERIDO | FALECIDO

  // Ecclesiastical data
  isBaptized     Boolean   @default(false)
  baptismDate    DateTime?
  conversionDate DateTime?

  // Address
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?

  // Relationships
  cellId   String?
  cell     Cell?   @relation("CellMember", fields: [cellId], references: [id])
  ledCells Cell[]  @relation("CellLeader")

  // Metadata
  notes        String?
  photoUrl     String?
  certificates Certificate[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("people")
}

model Certificate {
  id            String    @id @default(cuid())
  type          String
  title         String
  recipientName String
  description   String?
  issueDate     DateTime
  eventDate     DateTime?
  issuerName    String?

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("certificates")
}

model Cell {
  id        String    @id @default(cuid())
  name      String
  coverUrl  String?
  foundedAt DateTime?

  // Leader Information
  leaderName      String
  leaderPhone     String?
  leaderCpf       String?
  leaderBirthDate DateTime?

  // Address
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?

  // Functioning
  dayOfWeek String?
  time      String?
  isActive  Boolean @default(true)

  // Geolocation (for map)
  latitude  Float?
  longitude Float?

  // Relationships
  leaderId String?
  leader   Person?  @relation("CellLeader", fields: [leaderId], references: [id])
  members  Person[] @relation("CellMember")

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cells")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  time        String?
  location    String?
  type        String? // culto | reuniao | congresso
  isRecurrent Boolean  @default(false)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

model MonthlyReport {
  id             String   @id @default(cuid())
  referenceMonth DateTime @unique

  // Attendance
  totalMembers     Int @default(0)
  totalVisitors    Int @default(0)
  totalBaptisms    Int @default(0)
  totalConversions Int @default(0)
  totalTransfers   Int @default(0)

  // Financial
  totalTithes      Float @default(0)
  totalOfferings   Float @default(0)
  totalOtherIncome Float @default(0)
  totalExpenses    Float @default(0)

  notes       String?
  generatedAt DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("monthly_reports")
}
